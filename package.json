{
  "name": "mfs-operations-portal",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:client": "npm --workspace apps/client-pwa run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build && npm --workspace apps/client-pwa run build",
    "db:generate": "npm --workspace apps/api run db:generate",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed"
  }
}
